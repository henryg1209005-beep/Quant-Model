# Runtime
ENV=dev
SYMBOL=SPY
TIMEZONE=America/New_York

# Loop
PRIMARY_TIMEFRAME_MIN=5
SHORT_TIMEFRAME_MIN=1
LONG_TIMEFRAME_MIN=60
PRIMARY_BARS=15
SHORT_BARS=15
LONG_BARS=12
CYCLE_SECONDS=60

# Risk
MAX_POSITION_SIZE=10
MIN_SL_TICKS=6
MIN_TP_TICKS=8
MAX_TRADES_PER_DAY=12
MAX_DAILY_DRAWDOWN=1500

# Providers
DATA_PROVIDER=mock
EXECUTION_PROVIDER=mock
LLM_PROVIDER=mock

# LLM
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
OPENAI_TEMPERATURE=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SECONDARY_MODEL=gemini-2.5-pro
GEMINI_TEMPERATURE=
GEMINI_TIMEOUT_SECONDS=30
GEMINI_API_KEY=
LLM_TWO_TIER_ENABLED=true
LLM_TWO_TIER_SECONDARY_PROVIDER=gemini
LLM_TWO_TIER_ESCALATE_ON_TRADE=true
LLM_TWO_TIER_REQUIRE_CONFIDENCE_BAND=true
LLM_TWO_TIER_MIN_CONFIDENCE=0.52
LLM_TWO_TIER_MAX_CONFIDENCE=0.70
LLM_MAX_CONTEXT_CHARS=12000
LLM_MAX_OUTPUT_TOKENS=400
LLM_STATE_CHANGE_GATE_ENABLED=true
LLM_STATE_CHANGE_MIN_SECONDS=180
LLM_STATE_CHANGE_PRICE_BPS=6.0
LLM_STATE_CHANGE_TREND_DELTA=8.0
LLM_STATE_CHANGE_MOMENTUM_DELTA=8.0

# Alpaca (paper)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADING_URL=https://paper-api.alpaca.markets

# Entry quality gates
ENABLE_SESSION_FILTER=true
SESSION_START_ET=09:35
SESSION_END_ET=15:45
MAX_SPREAD_BPS=8.0
ENTRY_CONFLUENCE_MIN=58.0
PRICE_TICK_SIZE=0.01
RISK_PER_TRADE_USD=75.0
EV_MIN_TICKS=0.2
TRADE_BLOCKED_SYMBOLS=SPY
SIGNED_BPS_KILL_ENABLED=true
SIGNED_BPS_KILL_THRESHOLD=-5.0
SIGNED_BPS_KILL_MIN_LABELS=100
SIGNED_BPS_KILL_HORIZON_MINUTES=15
SIGNED_BPS_KILL_REFRESH_SECONDS=300
EDGE_WINDOW_TRADES=40
EDGE_MIN_WIN_RATE=0.42
EDGE_MIN_EXPECTANCY=0.0
EDGE_THROTTLE_SIZE_MULT=0.6
EDGE_MONITOR_STATE_PATH=data/edge_monitor_state.json
SHADOW_CHALLENGER_ENABLED=false
SHADOW_CONFLUENCE_BUMP=6.0
SHADOW_EV_BUMP=0.4

# Macro context
MACRO_CONTEXT_ENABLED=true
MACRO_PROVIDER=manual
MACRO_SNAPSHOT_PATH=data/macro_snapshot.json
FRED_API_KEY=
MACRO_REQUEST_TIMEOUT_SECONDS=8
MACRO_RISK_REGIME=unknown
MACRO_RATE_REGIME=unknown
MACRO_INFLATION_REGIME=unknown
MACRO_GROWTH_REGIME=unknown
MACRO_POLICY_BIAS=unknown
MACRO_NOTES=

# Adaptive learning
ADAPTIVE_ENABLED=true
ADAPTIVE_STATE_PATH=data/adaptive_state.json

# Autonomous live go-live gate
AUTONOMOUS_LIVE_ENABLED=false
GO_LIVE_MIN_CLOSED_TRADES=100
GO_LIVE_MIN_WIN_RATE=0.52
GO_LIVE_MIN_PROFIT_FACTOR=1.20
GO_LIVE_MIN_EXPECTANCY=0.0
GO_LIVE_MAX_DRAWDOWN_PCT=0.05
GO_LIVE_MAX_HOLD_RATE=0.90
GO_LIVE_METRICS_LOOKBACK=1000

# Institutional pre-trade risk gateway
PRETRADE_MAX_ORDER_NOTIONAL_USD=25000
PRETRADE_MAX_TOTAL_EXPOSURE_USD=75000
PRETRADE_MAX_QUOTE_AGE_SECONDS=5
PRETRADE_MAX_SPREAD_BPS=10.0
PRETRADE_MIN_BUYING_POWER_USD=1000
PRETRADE_DUPLICATE_COOLDOWN_SECONDS=15
MAX_POSITION_AGE_MINUTES=180
BROKER_SYNC_STALE_SECONDS=180
STALE_POSITION_FORCE_CLOSE=true
REQUIRE_BROKER_PROTECTION_ORDERS=true
PROTECTION_CHECK_GRACE_SECONDS=20
AUDIT_LOG_PATH=data/audit_events.jsonl

# Persistence
APP_DB_PATH=src/data/trading_app.db
DATABASE_URL=

# API
API_HOST=127.0.0.1
API_PORT=8000
ECONOMIC_CALENDAR_BLOCK_HIGH_IMPACT=false
ECONOMIC_CALENDAR_LOOKAHEAD_DAYS=7
FINNHUB_API_KEY=
ECONOMIC_CALENDAR_REQUEST_TIMEOUT_SECONDS=8
ECONOMIC_CALENDAR_HIGH_IMPACT_WINDOW_MINUTES=90
ECONOMIC_CALENDAR_PROVIDER=finnhub
ECONOMIC_CALENDAR_ENABLED=false
FINNHUB_NEWS_MAX_HEADLINES=3
FINNHUB_CONTEXT_ENABLED=false
FINNHUB_NEWS_LOOKBACK_DAYS=2
FINNHUB_REQUEST_TIMEOUT_SECONDS=8
EARNINGS_RISK_WINDOW_DAYS=2
FINNHUB_EARNINGS_LOOKAHEAD_DAYS=14
FINNHUB_NEWS_MIN_SCORE=1.5
SAMPLE_MAX_QUOTE_AGE_SECONDS=3600
MODEL_MONITORING_ENABLED=true
MODEL_MONITOR_LOOKBACK=10000
MODEL_MONITOR_HORIZON_MINUTES=30
MODEL_MONITOR_MIN_CONFIDENCE=0.0
MODEL_MONITOR_SHORT_WINDOW_DAYS=7
MODEL_MONITOR_LONG_WINDOW_DAYS=30
MODEL_MONITOR_MIN_LABELS=120
MODEL_MONITOR_MIN_ACCURACY_DELTA=-0.12
MODEL_MONITOR_MIN_SIGNED_BPS_DELTA=-15.0
MODEL_MONITOR_MAX_BRIER_DELTA=0.12
MODEL_MONITOR_BREACH_STREAK=5
MODEL_MONITOR_SAFE_MODE_ENABLED=true
MODEL_MONITOR_STATE_PATH=data/model_monitor_state.json
AUTOMATION_QUALITY_ENFORCE_VOLUME_OFFSESSION=false

SYMBOL_GATE_MIN_LABELS=50
SYMBOL_GATE_MIN_SIGNED_BPS=0.0
SYMBOL_GATE_HORIZON_MINUTES=15
SYMBOL_GATE_MIN_ACCURACY=0.50
SYMBOL_GATE_ENABLED=true
SYMBOL_GATE_REFRESH_SECONDS=300

# Signed-bps quarantine rails
SYMBOL_QUARANTINE_ENABLED=true
SYMBOL_QUARANTINE_HORIZON_MINUTES=15
SYMBOL_QUARANTINE_MIN_LABELS=30
SYMBOL_QUARANTINE_SIGNED_BPS_KILL=-15.0
SYMBOL_QUARANTINE_MINUTES=240
SYMBOL_QUARANTINE_RECOVER_MIN_LABELS=20
SYMBOL_QUARANTINE_RECOVER_SIGNED_BPS=2.0

# Weekly research loop (frozen architecture, one-variable experiments)
RESEARCH_FREEZE_ENABLED=true
WEEKLY_EXPERIMENTS_ENABLED=true
WEEKLY_EXPERIMENTS_MAX_PER_WEEK=3
WEEKLY_EXPERIMENT_MIN_LABELS=120
WEEKLY_EXPERIMENT_STRESS_MULTIPLIER=1.5

# Strict auto-promotion gate
AUTO_PROMOTION_GATE_ENABLED=true
AUTO_PROMOTION_MIN_LABELS=120
AUTO_PROMOTION_MIN_STRESSED_SIGNED_BPS=0.0
AUTO_PROMOTION_REQUIRE_OOS_POSITIVE=true

SAMPLE_FLOW_GUARD_ENABLED=true
SAMPLE_FLOW_GUARD_STALL_MINUTES_IN_SESSION=12
